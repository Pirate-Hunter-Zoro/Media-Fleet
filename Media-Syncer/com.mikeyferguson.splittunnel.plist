<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- OPT-IN, ROOT LaunchDaemon (not auto-installed). Routes required services around the
         Tailscale/Mullvad exit node, both of which the VPN actively breaks:
           * AI PROVIDERS (Groq/Cloudflare/OpenRouter/DeepSeek) -- datacenter exits are
             403'd outright and rotation resets in-flight calls.
           * GOOGLE     -- so the YouTube ingest always authenticates from the stable home
                           IP. Mullvad datacenter exits get an authenticated YouTube session
                           REVOKED (not captcha'd), and rotation looks like a stolen cookie.
           * TORRENT INDEXERS (1337x/eztv/...) -- Cloudflare 403s/decoy-blocks the datacenter
                           exit, so their search is pinned around the VPN too (search only;
                           the P2P download stays on Mullvad via the default route).
         MEGA is untouched (own infra), so throttle avoidance is not weakened; torrent
         DOWNLOADS keep exiting through Mullvad. Install with the sudo steps in the script's
         header, and preview with `bash scripts/split_tunnel.sh --dry-run` (no root needed). -->
    <key>Label</key>
    <string>com.mikeyferguson.splittunnel</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/usr/local/bin/split_tunnel.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>StandardOutPath</key>
    <string>/tmp/split_tunnel.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/split_tunnel.err</string>
</dict>
</plist>
