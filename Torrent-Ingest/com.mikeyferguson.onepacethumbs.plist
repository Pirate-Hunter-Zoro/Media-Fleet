<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mikeyferguson.onepacethumbs</string>

    <!-- Generates a representative episode thumbnail (ffmpeg frame) for shows with no
         image provider (One Pace), for episodes missing a -thumb.jpg / Primary image.
         Idempotent and capped per run, so it backfills gradually and picks up new media
         as it lands. Loops internally; KeepAlive restarts it if it dies. -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/Caskroom/miniconda/base/envs/torrent_ingest_env/bin/python3</string>
        <string>/Users/mikeyferguson/Developer/Torrent-Ingest/scripts/onepace_thumbs.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mikeyferguson/Developer/Torrent-Ingest</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/Users/mikeyferguson/Library/Logs/OnePaceThumbs.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mikeyferguson/Library/Logs/OnePaceThumbs.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/mikeyferguson/.local/bin</string>
        <key>JELLYFIN_URL</key>
        <string>http://127.0.0.1:8096</string>
        <key>JELLYFIN_API_KEY</key>
        <string>__JELLYFIN_API_KEY__</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
