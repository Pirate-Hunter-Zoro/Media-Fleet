<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mikeyferguson.jellyfindbguardian</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/mikeyferguson/Developer/Media-Orchestrator/Torrent-Ingest/run_db_guardian.sh</string>
    </array>

    <!-- The daemon runs its own loop; KeepAlive restarts it only if it dies.
         Must be a LaunchAgent (loaded in the user's GUI session), not a
         LaunchDaemon: it drives the Jellyfin GUI app (osascript quit / open -a)
         and posts user notifications, neither of which works from a system
         daemon context. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/mikeyferguson/Library/Logs/JellyfinDbGuardian.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mikeyferguson/Library/Logs/JellyfinDbGuardian.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
