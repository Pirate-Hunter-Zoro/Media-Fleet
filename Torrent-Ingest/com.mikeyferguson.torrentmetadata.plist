<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mikeyferguson.torrentmetadata</string>

    <!-- Nightly metadata safety net: audit the library for blank episodes and
         repair any that have stayed blank long enough that the scraper clearly
         failed on them. This is a scheduled one-shot, not a daemon. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/mikeyferguson/Developer/Torrent-Ingest/scripts/nightly_metadata.sh</string>
    </array>

    <!-- Run once a day at 04:30, after Jellyfin's own nightly scan has had its
         chance to scrape. RunAtLoad is false: no burst on load/bounce. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/mikeyferguson/Library/Logs/TorrentMetadata.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mikeyferguson/Library/Logs/TorrentMetadata.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <!-- Same Jellyfin endpoint as the ingest daemon, so the repair can nudge
             a rescan when it fills metadata. -->
        <key>JELLYFIN_URL</key>
        <string>http://127.0.0.1:8096</string>
        <key>JELLYFIN_API_KEY</key>
        <string>__JELLYFIN_API_KEY__</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
