#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# pre-commit -- keep credentials out of every commit in this repo.
#
# The repository is public. rclone.conf is NO LONGER tracked: it is the MEGA
# account pool (user/pass credentials) and lives machine-local, covered by the
# root `.gitignore`, exactly like `.env` (machine paths + keys). This hook is the
# belt to that pair of braces: `.gitignore` stops `git add -A`, and this stops an
# explicit `git add -f` or a stray path from ever reaching a commit.
#
# Two classes are handled, both by EDITING THE INDEX rather than rejecting the
# commit. A hook that blocks is a hook people bypass with `--no-verify`, and the
# working tree often belongs to a live daemon that is entitled to keep writing it
# (rclone caches its session in the very file below). So:
#
#   1. Files that must never be tracked -- `rclone.conf` and `.env` (including
#      `.env.*`, but not the tracked `.env.example`). Their index entry is removed;
#      the working file is untouched.
#   2. Credential VALUES that could still slip into a tracked file -- rclone's
#      cached `session_id`/`master_key` lines, and a Jellyfin API key typed into a
#      plist. The STAGED BLOB is rewritten to a placeholder; the working tree is not.
#
# The session-token case is why this hook exists. rclone writes back to its config
# after every successful login; on 2026-09-09 two `session_id`/`master_key` lines
# reached origin as a side effect of an unrelated deploy. Diagnosis §4.3 has said
# "never commit a MEGA session token" from the beginning, and §4.24 is the lesson
# that a rule the deploy script breaks is not a rule. This is the rule git enforces.
#
# Enabled per clone, once:
#     git config core.hooksPath .githooks
# (scripts/save-and-push.sh does it for you if it is not already set.)
# ---------------------------------------------------------------------------
set -uo pipefail

# Only the keys rclone caches. Deliberately NOT `pass`: a tracked conf is now
# itself forbidden, so there is no legitimate case for a plaintext password here.
SECRET_KEYS='^[[:space:]]*(session_id|master_key)[[:space:]]*='
# A real Jellyfin API key embedded in a plist: 32 hex chars between the tags.
JELLYFIN_KEY_RE='(<key>JELLYFIN_API_KEY</key>[[:space:]]*<string>)[0-9a-f]{32}(</string>)'

# --- 1. unstage machine-local secret files ----------------------------------
unstaged=0
while IFS= read -r path; do
  [ -n "$path" ] || continue
  case "$path" in
    .env.example|*/.env.example) continue ;;      # tracked template, not a secret
    .env|*/.env|.env.*|*/.env.*)
      if git rm --cached --quiet -- "$path"; then
        echo "pre-commit: unstaged $path -- machine-local, must never be tracked."
        unstaged=$((unstaged + 1))
      fi
      ;;
    rclone.conf|*/rclone.conf)
      if git rm --cached --quiet -- "$path"; then
        echo "pre-commit: unstaged $path -- the MEGA account pool must never be tracked."
        unstaged=$((unstaged + 1))
      fi
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACM)

# --- 2. scrub credential values from anything still staged ------------------
# A HERE-STRING, never `printf ... | grep`. `grep -q` exits on its first match, the
# writer takes SIGPIPE, and with `pipefail` set that makes the whole PIPELINE fail --
# so the `|| continue` below skipped every file and this hook silently did nothing
# while exiting 0. A guard whose failure mode is to pass is not a guard (§4.5); it was
# caught only by testing it against a file that DID carry a token, which it committed.
cleaned=0
while IFS= read -r path; do
  [ -n "$path" ] || continue
  # The staged blob, not the working file: the working file is rclone's.
  staged="$(git show ":$path" 2>/dev/null)" || continue

  changed=0
  if grep -Eq "$SECRET_KEYS" <<<"$staged"; then
    changed=1
  fi
  if [[ "$path" == *.plist ]] && grep -Eq "$JELLYFIN_KEY_RE" <<<"$staged"; then
    # `sed -E` on macOS BSD supports {32}; the value is hex, so the substitution is safe.
    staged="$(sed -E "s|$JELLYFIN_KEY_RE|\1__JELLYFIN_API_KEY__\2|g" <<<"$staged")"
    changed=1
  fi
  [ "$changed" = "1" ] || continue

  tmp="$(mktemp)" || continue
  # `git show` drops the trailing newline; the redirect below puts one back, so the
  # blob is a well-formed text file rather than one missing its final newline.
  if grep -Eq "$SECRET_KEYS" <<<"$staged"; then
    grep -Ev "$SECRET_KEYS" <<<"$staged" > "$tmp"
    # Collapse the blank line the removal leaves behind, so the committed config
    # does not accumulate a gap under every remote rclone has logged into.
    if command -v awk >/dev/null 2>&1; then
      awk 'BEGIN{b=0} /^[[:space:]]*$/{b++; next} {while(b>1){print ""; b--} if(b==1){print ""; b=0} print} END{if(b>0)print ""}' \
        "$tmp" > "$tmp.sq" 2>/dev/null && mv "$tmp.sq" "$tmp"
    fi
  else
    printf '%s\n' "$staged" > "$tmp"
  fi

  blob="$(git hash-object -w "$tmp")" || { rm -f "$tmp"; continue; }
  mode="$(git ls-files --stage -- "$path" | awk '{print $1}')"
  [ -n "$mode" ] || mode=100644
  if git update-index --cacheinfo "$mode,$blob,$path"; then
    n="$(grep -Ec "$SECRET_KEYS" <<<"$staged" || true)"
    if [ "${n:-0}" != "0" ]; then
      echo "pre-commit: stripped $n MEGA session token line(s) from the committed" \
           "copy of $path (§4.3). Your working file is unchanged."
    fi
    if [[ "$path" == *.plist ]]; then
      echo "pre-commit: replaced a live Jellyfin API key in the committed copy of" \
           "$path with __JELLYFIN_API_KEY__. Your working file is unchanged."
    fi
    cleaned=$((cleaned + 1))
  fi
  rm -f "$tmp"
done < <(git diff --cached --name-only --diff-filter=ACM)

exit 0
