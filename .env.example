# Machine-local configuration for the Media-Fleet monorepo.
#
# Copy this file to `.env` (untracked; `.gitignore` covers it) and fill in the real
# values for THIS machine. `.env` is loaded by `fleet_env.py` and by the launchd
# installers; values already present in the process environment always win, so a
# launchd plist can override anything here.
#
# Keep the secrets OUT of git. The repo is public; `.env` is not.
#
# Paths may be written with `~` for the home directory. Values run to end-of-line
# (spaces are fine, no inline comments).

# --- Library roots -----------------------------------------------------------
# The iCloud folder watched for dropped `.torrent` files and the DirectIngest mirror.
TORRENTS_DIR=~/Library/Mobile Documents/com~apple~CloudDocs/Torrents
# The SSD library root beneath the mediafs mount (Shows/Movies/Comics).
MEDIA_ROOT=~/Media
# Where the mediafs FUSE mount is served (Jellyfin/YacReader read this path).
MEDIAFS_MOUNT=~/MediaLibrary
# Files a single MEGA account can never hold are moved here (same volume as MEDIA_ROOT).
UNPLACEABLE_DIR=~/unplaceable_media
# Light novels/e-books, served outside the media library (macOS Google Drive mount).
# Example: ~/Library/CloudStorage/GoogleDrive-you@example.com/My Drive/Novels
NOVELS_ROOT=~/Novels
# Audio tracks downloaded by YouTube-Downloader (macOS Google Drive Music folder).
# Example: ~/Library/CloudStorage/GoogleDrive-you@example.com/My Drive/Music
MUSIC_DIR=~/Music

# --- Repo sibling paths ------------------------------------------------------
# Where the Media-Syncer project lives (used for the reaper's queues/inventory).
MEDIA_SYNCER_DIR=~/Developer/Media-Fleet/Media-Syncer
# The committed repo copy of the MEGA account pool. Untracked; copy
# Media-Syncer/rclone.conf.example to this path and fill it in.
MEDIA_SYNCER_RCLONE_CONF=~/Developer/Media-Fleet/Media-Syncer/rclone.conf

# --- rclone ------------------------------------------------------------------
# The live rclone config rclone itself reads (session tokens live ONLY here).
RCLONE_CONFIG=~/.config/rclone/rclone.conf

# --- MEGA account provisioner ------------------------------------------------
# Base inbox for `+alias` account creation. The IMAP app-password lives outside the
# repo at ~/.config/media-syncer/email_app_password and is never committed.
ACCOUNT_EMAIL_BASE=you@example.com

# --- Jellyfin -----------------------------------------------------------------
# The API key is a credential: it lives here and in the installed launchd plists
# (substituted at install time), never in the tracked tree.
JELLYFIN_URL=http://127.0.0.1:8096
JELLYFIN_API_KEY=replace-with-your-jellyfin-api-key
