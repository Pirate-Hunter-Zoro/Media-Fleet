# Repository-root ignores. Each sub-project keeps its own .gitignore for its own
# state/logs/secrets; git applies those relative to their directory, so this file only
# covers the root.
#
# .DS_Store
.DS_Store

# Keep node_modules out if any tooling ever installs one here. The opencode CLI itself is
# a global Homebrew/npm install and its manifest lives at ~/Developer, outside this repo.
node_modules/
