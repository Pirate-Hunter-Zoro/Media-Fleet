-:Thumbs.db
-:desktop.ini
-:~*
-:.*
-:*~.*
-:*.crdownload
-:*.sb-????????-??????
-:*.tmp
# Transient churn that must never be backed up: identify-run temp logs, caches, run logs,
# and SQLite WAL/SHM sidecars. These change every few seconds and, with MEGAsync's version
# history, are what ballooned the mtf6056 account's usage. Real state (journal.jsonl,
# library.db, seen.json, ...) stays backed up.
-d:__pycache__
-:*.pyc
-:*.log
-:*.db-wal
-:*.db-shm
-:*.parts
-p:Torrent-Ingest/state/tmp
-p:Media-Syncer/state/tmp
-p:node_modules/opencode-darwin-arm64/bin/opencode
-p:node_modules/opencode-ai/bin/opencode.exe
# The library DB and the blocklist moved from Torrent-Searcher/state/ to
# Torrent-Ingest/state/ on 2026-09-10 when the searcher was removed. These exclusions had
# to move with them: library.db is ~10 MB and rewritten constantly, and with MEGAsync's
# version history turned on that is exactly the churn that ballooned an account's usage.
# Leaving the old paths here would have silently stopped excluding anything.
-p:Torrent-Ingest/state/blocklist.json
-p:Torrent-Ingest/state/library.db
-s:*